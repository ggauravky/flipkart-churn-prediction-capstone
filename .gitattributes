# Lock exact binary bytes for records.csv to guarantee MD5 c6f249ba693f1ebeed318d6d5e18de23
data/records.csv -text

# Lock exact binary bytes for CSV outputs generated by python csv.writer (RFC 4180 CRLF)
outputs/*.csv -text

# Consistent LF line endings for text results, code, and documentation
outputs/*.txt text eol=lf
*.py text eol=lf
*.md text eol=lf
requirements.txt text eol=lf
.gitignore text eol=lf
